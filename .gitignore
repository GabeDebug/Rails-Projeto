# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`
# Dependências Ruby
/.bundle
/vendor/bundle

# Logs e temporários
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Banco SQLite
/db/*.sqlite3
/db/*.sqlite3-journal

# Storage e uploads
/storage/*
!/storage/.keep

# Node
/node_modules

# Assets compilados
/public/assets

# Variáveis de ambiente
.env
.env.local
.env.production

# Credenciais Rails
/config/master.key

# Cache
/tmp/cache
/tmp/pids
/tmp/sockets

# Yarn
/yarn-error.log

# Sistema operacional
.DS_Store
Thumbs.db

# VSCode
.vscode

# JetBrains
.idea

# Arquivos de swap
*.swp

# Coverage
/coverage

# Rubocop
.rubocop-https---*

# Spring
/spring/*.pid

# Byebug
.byebug_history

# Direnv
.envrc

# Docker
docker-compose.override.yml

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

